	;; WHITESPACE OVERRIDES
	`(whitespace-space            ((t (:background ,bg1 :foreground ,subtle))))
	`(whitespace-tab              ((t (:background ,bg1 :foreground ,subtle))))
	`(whitespace-hspace           ((t (:background ,bg1 :foreground ,subtle))))
	`(whitespace-newline          ((t (:background ,bg1 :foreground ,subtle))))
	`(whitespace-indentation      ((t (:background ,bg1 :foreground ,subtle))))
	`(whitespace-space-after-tab  ((t (:background ,bg1 :foreground ,subtle))))
	`(whitespace-space-before-tab ((t (:background ,bg1 :foreground ,subtle))))
	`(whitespace-line             ((t (:background unspecified :foreground unspecified))))
	`(whitespace-trailing         ((t (:background "#590008"   :foreground unspecified))))

