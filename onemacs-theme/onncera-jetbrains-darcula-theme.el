	`(mode-line-buffer-id                      ((,class (:bold nil :foreground ,accent :background nil))))
	`(mode-line-highlight                      ((,class (:foreground ,keyword :box nil :weight normal))))
	`(mode-line-emphasis                       ((,class (:foreground ,fg1))))
